<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Metadata -->
    <PackageId>ReCoResult</PackageId>
    <Version>1.0.0</Version>
    <Authors>plazmatiz</Authors>
    <Description>Lightweight Result pattern library for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>result;result-pattern;error-handling;functional;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/plazmatiz/ReCoResult</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/plazmatiz/ReCoResult</PackageProjectUrl>

    <!-- Include XML documentation in the package -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>